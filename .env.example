# =============================================================================
# Plantilla de Configuración de Entorno (.env.example)
# Instrucciones: Copia este archivo a `.env` y reemplaza los valores ficticios
# por credenciales fuertes generadas localmente. NUNCA subas `.env` a Git.
# =============================================================================

# --- Versión e Infraestructura Wazuh Single-Node (Docker) ---
WAZUH_IMAGE_VERSION=4.9.2

# Enlace estricto a localhost para consola web, API e indexador (evita exposición en LAN/Wi-Fi)
WAZUH_LOCAL_BIND_IP=127.0.0.1

# Enlace exclusivo a la interfaz privada Host-Only (ej. VMnet1 / vboxnet0) para ingesta de agentes
WAZUH_AGENT_BIND_IP=192.168.56.1

# --- Credenciales del Clúster Wazuh (Cambiar obligatoriamente en `.env`) ---
INDEXER_USERNAME=admin
INDEXER_PASSWORD=ChangeMe_LabIndexer_2026!
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=ChangeMe_LabDashboard_2026!
API_USERNAME=wazuh-wui
API_PASSWORD=ChangeMe_LabWazuhApi_2026!

# --- Conexión del Motor de Triaje Python (Fase 6) ---
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_VERIFY_SSL=false
TRIAGE_MIN_ALERT_LEVEL=10

# --- APIs Externas de Cyber Threat Intelligence (CTI) ---
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# --- Resiliencia, Rate Limiting y Caché Local ---
CTI_HTTP_TIMEOUT_SECONDS=10
CTI_CACHE_TTL_HOURS=24
CTI_CACHE_DB_PATH=automation/.cti_cache.sqlite3
