# Normalización estricta a LF para archivos consumidos por contenedores Linux y CI
* text=auto eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
.env* text eol=lf

# Scripts nativos de Windows PowerShell
*.ps1 text eol=crlf
